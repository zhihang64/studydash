# ---- 含登录态 / 账号页面原文 / 真实课程数据，绝不提交 ----
config.json
data/
out/
# 测试/调试用的临时工作区（内含 progress.json 与页面原文）
.tmp_*/
.tmp*
.crash-home/

# ---- 打包产物 ----
build/
dist/
*.spec

# ---- 前端 ----
# node_modules 和 vite 的中间产物不进仓库；构建产物 src/studydash/web/static/
# 反而要进（pip 装完就得能跑，不能让用户先装 Node）。
web/node_modules/
web/.vite/
web/dist/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# pytest 在 Windows 上跑 --basetemp 时留下的临时根目录
pytest-of-*/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# 构建中间产物
*.whl
dist_wheel/
*.egg-info/
